# The public origin of the site, used for canonical links and the sitemap.
# Not a secret. Keep it in step with SITE_URL in .github/workflows/deploy.yml.
SITE_URL=https://jeffrey-ankrah.pages.dev

# Cloudflare Web Analytics token. Leave it empty locally so your own visits
# are not counted; .github/workflows/deploy.yml sets it for main only.
PUBLIC_CF_BEACON_TOKEN=
