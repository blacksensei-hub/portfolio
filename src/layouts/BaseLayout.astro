---
import { getCollection, getEntry } from 'astro:content';

import Container from '../components/ui/Container.astro';
import { glyphs } from '../components/ui/glyphs';
import SkipLink from '../components/ui/SkipLink.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { beaconAttr } from '../lib/analytics';
import { THEME_HEAD_SCRIPT } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  /** Keeps the page out of search results (the styleguide). */
  noindex?: boolean | undefined;
  /** Open Graph, X, and JSON-LD for a shareable page (spec 0006). */
  social?:
    | {
        /** Site relative path to the 1200 by 630 PNG card. */
        image: string;
        imageAlt: string;
        siteName: string;
        jsonLd: object;
      }
    | undefined;
}

const { title, description, noindex = false, social } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = social && new URL(social.image, Astro.site).href;
// Escaping `<` keeps content from ever closing the script tag early.
const jsonLd = social && JSON.stringify(social.jsonLd).replace(/</g, '\\u003c');
// Production only: deploy.yml sets the token just for pushes to main (spec 0010).
const beacon = beaconAttr(import.meta.env.PUBLIC_CF_BEACON_TOKEN);

// The footer signs the page with the profile and the GitHub link from links.yaml.
const profile = (await getEntry('profile', 'profile'))?.data;
const links = (await getCollection('links'))
  .toSorted((a, b) => a.data.order - b.data.order)
  .map((link) => link.data);
const now = new Date();
const year = now.getFullYear();
const updated = now.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
const footerNav = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#work-with-me', label: 'Services' },
  { href: '/#contact', label: 'Contact' },
];
const statusLabel = {
  open: 'Available for work',
  limited: 'Limited availability',
  closed: 'Currently booked',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={THEME_HEAD_SCRIPT}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {social && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={social.imageAlt} />
        <meta property="og:site_name" content={social.siteName} />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={social.imageAlt} />
        <script is:inline type="application/ld+json" set:html={jsonLd}></script>
      </>
    )}
    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={beacon}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body class="bg-surface text-on-surface font-sans antialiased">
    <SkipLink />
    {/*
      One fixed environment layer behind everything (spec 0011): two soft thread
      colored glows drifting over 90 seconds. Decorative, and still under reduced motion.
    */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="animate-drift absolute -top-1/3 -right-1/4 size-[70vmax] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--color-thread-gold)_16%,transparent),transparent)]"></div>
      <div class="animate-drift absolute -bottom-1/3 -left-1/4 size-[60vmax] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--color-thread-green)_10%,transparent),transparent)] [animation-direction:reverse]"></div>
    </div>
    {/* A page with a site header carries the toggle inside it instead. */}
    {!Astro.slots.has('header') && <ThemeToggle />}
    {/* Reading progress along the top edge, driven by a CSS scroll timeline (spec 0012). */}
    <div
      aria-hidden="true"
      class="scroll-progress bg-accent pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5"
    ></div>
    <slot name="header" />
    <!-- Below sm, reserve room so the fixed theme toggle never sits on the first heading. -->
    <main id="main" tabindex="-1" class="max-sm:pt-16">
      <slot />
    </main>
    <footer class="border-border relative mt-8 border-t">
      <Container>
        <div class="grid gap-10 py-12 sm:grid-cols-2 md:grid-cols-12">
          {profile && (
            <div class="md:col-span-5">
              <a href="/#hero" class="group/logo inline-flex items-center gap-2.5">
                <span
                  aria-hidden="true"
                  class="bg-accent text-on-accent font-display grid size-8 place-items-center rounded-lg text-sm font-bold transition-transform group-hover/logo:rotate-[-8deg]"
                >
                  {profile.name
                    .split(/\s+/)
                    .filter((_, n, all) => n === 0 || n === all.length - 1)
                    .map((w) => w.charAt(0))
                    .join('')}
                </span>
                <span class="font-display font-semibold">{profile.name}</span>
              </a>
              <p class="text-muted mt-3 max-w-[38ch] text-sm">
                {profile.role}. Web, mobile, and backend work, from first idea to launch.
              </p>
              {profile.availability && (
                <p class="mt-5 inline-flex items-center gap-2 text-sm">
                  <span aria-hidden="true" class="bg-status-open relative size-2 rounded-full">
                    <span class="bg-status-open absolute inset-0 animate-ping rounded-full opacity-60"></span>
                  </span>
                  {statusLabel[profile.availability.status]}
                </p>
              )}
            </div>
          )}
          <nav aria-label="Footer" class="md:col-span-2">
            <p class="text-muted mb-3 font-mono text-label uppercase">Explore</p>
            <ul role="list" class="grid gap-2 text-sm">
              {footerNav.map(({ href, label }) => (
                <li>
                  <a href={href} class="hover:text-accent transition-colors">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="md:col-span-3">
            <p class="text-muted mb-3 font-mono text-label uppercase">Connect</p>
            <ul role="list" class="grid gap-2 text-sm">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-accent inline-flex items-center gap-2 transition-colors"
                    {...(/^https?:/.test(link.href) && {
                      target: '_blank',
                      rel: 'noopener noreferrer',
                    })}
                  >
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 24 24"
                      class="text-accent size-4 fill-current"
                    >
                      <path d={glyphs[link.icon]} />
                    </svg>
                    {link.label}
                    {/^https?:/.test(link.href) && (
                      <span class="sr-only"> (opens in a new tab)</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="md:col-span-2">
            <p class="text-muted mb-3 font-mono text-label uppercase">Local time</p>
            <p class="font-display text-2xl font-semibold tabular-nums">
              <time data-local-clock>GMT</time>
            </p>
            <p class="text-muted mt-1 text-sm">Ghana, GMT+0</p>
          </div>
        </div>
        <div class="border-border text-muted flex flex-col gap-3 border-t py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
          {profile && (
            <p>
              © {year} {profile.name}
            </p>
          )}
          <p class="font-mono text-xs">Last updated {updated}</p>
          <a
            href="#main"
            class="hover:text-accent group/top inline-flex items-center gap-2 transition-colors"
          >
            Back to top
            <span aria-hidden="true" class="transition-transform group-hover/top:-translate-y-0.5">
              ↑
            </span>
          </a>
        </div>
      </Container>
    </footer>
    <script>
      import { initInteractions } from '../lib/interactions';

      initInteractions();
    </script>
  </body>
</html>
