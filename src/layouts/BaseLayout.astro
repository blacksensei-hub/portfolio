---
import SkipLink from '../components/ui/SkipLink.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  /** Keeps the page out of search results (the styleguide). */
  noindex?: boolean | undefined;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body class="bg-surface text-on-surface font-sans antialiased">
    <SkipLink />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
