---
interface Props {
  name: string;
  sections: { id: string; label: string }[];
}

/*
 * Liquid glass nav (spec 0012). A floating frosted pill that starts roomy and
 * shrinks into a compact pill over the first 240px of scroll, driven by a CSS
 * scroll timeline: no script. The link for the section in view lights up via
 * :target-current where supported. Desktop only: below md the page is one short
 * column and the nav would crowd the theme toggle.
 */
const { name, sections } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter((_, n, all) => n === 0 || n === all.length - 1)
  .map((word) => word.charAt(0))
  .join('');
---

<header class="px-gutter pointer-events-none fixed inset-x-0 top-0 z-40 hidden md:block">
  <div class="glass glass-nav rounded-tag pointer-events-auto mx-auto mt-4 max-w-[64rem] py-2 pr-2 pl-5">
    <nav aria-label="Sections" class="flex items-center gap-6">
      <a
        href="#hero"
        class="font-display hover:text-accent mr-auto text-xl font-bold tracking-tight transition-colors"
      >
        {initials}
        <span class="text-accent" aria-hidden="true">
          .
        </span>
        <span class="sr-only">, back to top</span>
      </a>
      <ul role="list" class="flex items-center gap-1 [scroll-target-group:auto]">
        {sections.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              class="rounded-tag text-muted hover:text-on-surface hover:bg-on-surface/8 [&:target-current]:bg-accent [&:target-current]:text-on-accent inline-flex min-h-11 items-center px-4 font-mono text-label uppercase transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
