---
import type { CollectionEntry } from 'astro:content';

import { glyphs } from './glyphs';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
  sections: { id: string; label: string }[];
  links: CollectionEntry<'links'>['data'][];
}

/*
 * Liquid glass nav (specs 0012, 0013). A floating frosted pill that shrinks over
 * the first 240px of scroll (CSS scroll timeline). Left: monogram and name.
 * Centre: a segmented group of section links, the one in view lit through
 * :target-current. Right: quick social icons and the theme toggle. The toggle
 * is first in the DOM (the first Tab stop after the skip link, spec 0008) and
 * placed last visually with `order-last`.
 */
const { name, sections, links } = Astro.props;
const parts = name.split(/\s+/);
const initials = `${parts[0]?.charAt(0) ?? ''}${parts.at(-1)?.charAt(0) ?? ''}`;
const short = `${parts[0] ?? ''} ${parts.at(-1) ?? ''}`;
const quick = links.filter((link) => link.icon !== 'phone').slice(0, 3);
---

<header class="px-gutter pointer-events-none fixed inset-x-0 top-0 z-40">
  <div class="glass glass-nav rounded-tag pointer-events-auto mx-auto mt-3 flex max-w-[62rem] items-center gap-2 py-1.5 pr-1.5 pl-2 md:mt-4">
    <ThemeToggle inline />
    <a
      href="#hero"
      class="group/logo hover:bg-on-surface/8 rounded-tag mr-auto flex min-h-11 items-center gap-2.5 pr-3 pl-1.5 transition-colors"
    >
      <span
        aria-hidden="true"
        class="bg-accent text-on-accent font-display grid size-8 place-items-center rounded-lg text-sm font-bold transition-transform duration-(--duration-hover) group-hover/logo:rotate-[-8deg]"
      >
        {initials}
      </span>
      <span class="font-display hidden text-sm font-semibold sm:inline">{short}</span>
      <span class="sr-only">, back to top</span>
    </a>
    {/* Phone menu: a plain disclosure, so the sections are reachable with no script. */}
    <details class="group/menu relative md:hidden" data-menu>
      <summary
        class="hover:bg-on-surface/8 grid size-11 cursor-pointer list-none place-items-center rounded-full transition-colors [&::-webkit-details-marker]:hidden"
        aria-label="Sections menu"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-5"
        >
          <path
            d="M4 7h16"
            class="origin-center transition-transform group-open/menu:translate-y-[5px] group-open/menu:rotate-45"
          />
          <path d="M4 12h16" class="transition-opacity group-open/menu:opacity-0" />
          <path
            d="M4 17h16"
            class="origin-center transition-transform group-open/menu:-translate-y-[5px] group-open/menu:-rotate-45"
          />
        </svg>
      </summary>
      <nav
        aria-label="Menu"
        class="rounded-card border-border bg-surface absolute top-full right-0 mt-2 w-56 border p-2 shadow-2xl"
      >
        <ul role="list" class="grid gap-1">
          {sections.map(({ id, label }) => (
            <li>
              <a
                href={`#${id}`}
                class="rounded-tag hover:bg-on-surface/8 hover:text-accent flex min-h-11 items-center px-4 text-sm font-medium transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
          {links.map((link, n) => (
            <li class:list={[n === 0 && 'border-border mt-1 border-t pt-1']}>
              <a
                href={link.href}
                class="rounded-tag hover:bg-on-surface/8 hover:text-accent text-muted flex min-h-11 items-center gap-3 px-4 text-sm transition-colors"
                {...(/^https?:/.test(link.href) && {
                  target: '_blank',
                  rel: 'noopener noreferrer',
                })}
              >
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  class="text-accent size-4 fill-current"
                >
                  <path d={glyphs[link.icon]} />
                </svg>
                {link.label}
                {/^https?:/.test(link.href) && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
    <nav aria-label="Sections" class="hidden md:block">
      <ul
        role="list"
        class="bg-on-surface/5 border-border/60 rounded-tag flex items-center gap-0.5 border p-1 [scroll-target-group:auto]"
      >
        {sections.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              class="rounded-tag text-muted hover:text-on-surface hover:bg-on-surface/8 [&:target-current]:bg-accent [&:target-current]:text-on-accent inline-flex min-h-9 items-center px-3.5 text-sm font-medium transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ul role="list" class="ml-auto hidden items-center sm:flex" aria-label="Elsewhere">
      {quick.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            class="text-muted hover:text-accent hover:bg-on-surface/8 grid size-10 place-items-center rounded-full transition-colors"
            {...(/^https?:/.test(link.href) && { target: '_blank', rel: 'noopener noreferrer' })}
          >
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              class="size-[1.05rem] fill-current"
            >
              <path d={glyphs[link.icon]} />
            </svg>
          </a>
        </li>
      ))}
      <li aria-hidden="true" class="bg-border mx-1.5 h-5 w-px"></li>
    </ul>
  </div>
</header>
