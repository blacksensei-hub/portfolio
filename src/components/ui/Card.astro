---
interface Props {
  as?: 'article' | 'div';
}

// Never wraps the whole card in a link; links inside stay separate Tab stops.
// The lift and gold edge on hover are pure CSS (spec 0011).
const { as: Element = 'article' }: Props = Astro.props;
---

<Element class="group/card rounded-card border-border bg-surface-raised hover:border-accent relative overflow-hidden border p-6 transition-[border-color,translate] duration-(--duration-hover) ease-(--ease-out-soft) hover:-translate-y-1 md:p-8">
  <slot />
</Element>
