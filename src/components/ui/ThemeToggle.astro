---
// Three state theme toggle (spec 0008). Renders hidden in the system state;
// its script corrects the label and reveals it, so without JavaScript it never
// shows. Icons are Lucide (ISC licence): monitor, sun, moon.
import { themeLabel } from '../../lib/theme';
---

<button
  type="button"
  hidden
  data-theme-toggle
  aria-label={themeLabel('system')}
  class="fixed top-4 right-4 z-50 flex size-11 items-center justify-center rounded-full border border-border bg-surface-raised text-on-surface transition-colors hover:text-accent"
>
  <svg
    data-icon="system"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect width="20" height="14" x="2" y="3" rx="2"></rect>
    <line x1="8" x2="16" y1="21" y2="21"></line>
    <line x1="12" x2="12" y1="17" y2="21"></line>
  </svg>
  <svg
    data-icon="light"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    data-icon="dark"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  /* One icon at a time, keyed on the choice the head script already set. */
  svg {
    display: none;
  }
  :global(:root:not([data-theme-choice='light'], [data-theme-choice='dark'])) [data-icon='system'],
  :global(:root[data-theme-choice='light']) [data-icon='light'],
  :global(:root[data-theme-choice='dark']) [data-icon='dark'] {
    display: block;
  }
</style>

<script>
  import {
    applyChoice,
    nextChoice,
    readChoice,
    THEME_STORAGE_KEY,
    themeLabel,
  } from '../../lib/theme';

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    const current = () => readChoice(root.getAttribute('data-theme-choice'));

    button.setAttribute('aria-label', themeLabel(current()));
    button.hidden = false;

    button.addEventListener('click', () => {
      const next = nextChoice(current());
      applyChoice(root, next);
      button.setAttribute('aria-label', themeLabel(next));
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Blocked storage: the theme still applies for this page view.
      }
    });
  }
</script>
