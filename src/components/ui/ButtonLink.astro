---
import { isExternal } from './isExternal';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  download?: boolean;
}

// A link styled as a button: every call to action here navigates or downloads.
// Mono type, a light sheen on hover, and a gentle magnetic lean (spec 0012).
const { href, variant = 'primary', download = false } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  download={download || undefined}
  data-magnetic
  class:list={[
    'sheen group rounded-tag inline-flex min-h-11 items-center justify-center gap-2 border-2 border-accent px-6 py-2.5 font-mono text-sm font-medium tracking-wide uppercase transition-[background-color,color,translate]',
    variant === 'primary'
      ? 'bg-accent text-on-accent hover:bg-transparent hover:text-accent'
      : 'text-accent hover:bg-accent hover:text-on-accent',
  ]}
  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
>
  <slot />
  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
    →
  </span>
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
