---
/*
 * A slow ribbon of the tech stack between sections (spec 0012). Decorative:
 * the same items are listed properly in Skills, so this is aria-hidden. The
 * track is rendered twice and slides by half, so the loop never jumps. Pauses
 * on hover; stops under reduced motion.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div
  aria-hidden="true"
  class="group/marquee border-border overflow-hidden border-y py-6 [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]"
>
  <div class="animate-marquee flex w-max will-change-transform group-hover/marquee:[animation-play-state:paused]">
    {[0, 1].map(() => (
      <ul class="flex shrink-0 items-center">
        {items.map((item) => (
          <li class="font-display text-muted hover:text-accent flex items-center text-2xl font-medium tracking-tight transition-colors md:text-4xl">
            <span class="px-6 md:px-10">{item}</span>
            <span class="bg-thread-gold size-2 rounded-full" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
