---
import Container from './Container.astro';
import MaskText from './MaskText.astro';

interface Props {
  id: string;
  title: string;
  /** Mono chapter number shown in the badge beside the heading, e.g. "02". */
  index?: string | undefined;
  /** A short mono note at the far end of the heading row. */
  hint?: string | undefined;
}

// Compact heading row (spec 0013): number badge, heading, optional hint, and a
// hairline rule beneath that draws itself in from the left.
const { id, title, index, hint } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="py-section relative">
  <Container>
    <header class="mask-reveal relative mb-8 flex items-center gap-3 pb-4">
      {index && (
        <span
          aria-hidden="true"
          class="rounded-card border-border bg-surface-raised text-accent grid size-9 shrink-0 place-items-center border font-mono text-xs"
        >
          {index}
        </span>
      )}
      <h2 id={headingId} class="text-h2 font-semibold tracking-tight">
        <MaskText text={title} />
      </h2>
      {hint && (
        <p class="text-muted ml-auto hidden font-mono text-label uppercase sm:block">{hint}</p>
      )}
      <span
        aria-hidden="true"
        class="rule-draw from-accent via-border to-border absolute inset-x-0 bottom-0 h-px bg-gradient-to-r"
      ></span>
    </header>
    <slot />
  </Container>
</section>
