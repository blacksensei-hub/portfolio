---
import Container from './Container.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="py-section">
  <Container>
    <h2 id={headingId} class="text-h2 mb-6 font-semibold tracking-tight">
      {title}
    </h2>
    <slot />
  </Container>
</section>
