---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import Container from '../ui/Container.astro';
import MaskText from '../ui/MaskText.astro';
import StatusPill from '../ui/StatusPill.astro';
import Weave from '../ui/Weave.astro';

type Availability = NonNullable<CollectionEntry<'profile'>['data']['availability']>;

interface Props {
  name: string;
  role: string;
  tagline: string;
  email: string;
  availability?: Availability | undefined;
  /** Counts for the stat row, from the content collections. */
  stats: { value: number; label: string }[];
  /** A few headline technologies for the code card. */
  stack: string[];
}

// The top of the page and its only <h1>, so it is not a Section (which owns an <h2>).
const { name, role, tagline, email, availability, stats, stack } = Astro.props;
const short = name
  .split(/\s+/)
  .filter((_, n, all) => n === 0 || n === all.length - 1)
  .join(' ');

// The code card: a decorative restatement of the profile, typed in line by line.
type Token = { t: string; c?: string };
const lines: Token[][] = [
  [{ t: 'const ', c: 'text-thread-red' }, { t: 'developer' }, { t: ' = {', c: 'text-muted' }],
  [
    { t: '  name: ', c: 'text-muted' },
    { t: `"${short}"`, c: 'text-thread-green' },
    { t: ',', c: 'text-muted' },
  ],
  [
    { t: '  role: ', c: 'text-muted' },
    { t: `"${role}"`, c: 'text-thread-green' },
    { t: ',', c: 'text-muted' },
  ],
  [
    { t: '  stack: [', c: 'text-muted' },
    { t: stack.map((s) => `"${s}"`).join(', '), c: 'text-thread-green' },
    { t: '],', c: 'text-muted' },
  ],
  [
    { t: '  basedIn: ', c: 'text-muted' },
    { t: '"Ghana"', c: 'text-thread-green' },
    { t: ',', c: 'text-muted' },
  ],
  [
    { t: '  available: ', c: 'text-muted' },
    { t: String(availability?.status === 'open'), c: 'text-accent' },
    { t: ',', c: 'text-muted' },
  ],
  [{ t: '};', c: 'text-muted' }],
];
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative isolate overflow-hidden pt-10 pb-8 md:pt-(--spacing-header)"
>
  {/* Moving aurora over a faint grid floor: the MotionSites style backdrop. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="grid-floor absolute inset-0"></div>
    <div class="animate-aurora aurora-blob text-thread-gold/25 absolute top-[5%] left-[10%] size-[40rem] rounded-full"></div>
    <div class="animate-aurora aurora-blob text-thread-green/20 absolute top-[25%] right-[5%] size-[34rem] rounded-full [animation-delay:-6s]"></div>
    <div class="animate-aurora aurora-blob text-thread-red/15 absolute bottom-0 left-[40%] size-[28rem] rounded-full [animation-delay:-12s]"></div>
  </div>
  <div
    aria-hidden="true"
    data-spotlight
    class="spotlight pointer-events-none absolute inset-0 -z-10"
  ></div>

  <Container>
    <div class="grid items-center gap-12 pt-6 md:grid-cols-12 md:pt-10">
      <div class="md:col-span-7">
        {availability && (
          <div class="animate-rise mb-6">
            <StatusPill status={availability.status} />
          </div>
        )}
        <p class="animate-rise border-accent/40 bg-accent/10 text-accent rounded-tag mb-4 inline-block border px-3 py-1 font-mono text-label uppercase">
          <span class="shimmer-text">{role}</span>
        </p>
        <h1 id="hero-heading" class="text-hero font-bold tracking-tight">
          <MaskText text={name} mode="load" delay={150} />
        </h1>
        <p class="animate-rise text-muted text-lede mt-5 max-w-[46ch] [animation-delay:450ms]">
          {tagline}
        </p>
        <div class="animate-rise mt-7 flex flex-wrap gap-3 [animation-delay:550ms]">
          <ButtonLink href="#projects">View my work</ButtonLink>
          <ButtonLink href={`mailto:${email}`} variant="secondary">
            Email me
          </ButtonLink>
        </div>

        <dl class="animate-rise mt-10 flex flex-wrap gap-x-10 gap-y-4 [animation-delay:650ms]">
          {stats.map(({ value, label }) => (
            <div class="flex flex-col-reverse">
              <dt class="text-muted font-mono text-label uppercase">{label}</dt>
              <dd class="font-display text-2xl font-bold">
                <span aria-hidden="true" class="count-up" style={`--to: ${value}`} />
                <span class="sr-only">{value}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>

      {/* Decorative code card: the profile restated as code, typed in line by line. */}
      <div aria-hidden="true" class="animate-rise md:col-span-5 [animation-delay:300ms]">
        <div class="glass glow-border glow-border-on rounded-card shadow-2xl transition-transform duration-(--duration-hover) md:rotate-[1.5deg] md:hover:rotate-0">
          <div class="border-border/60 flex items-center gap-2 border-b px-4 py-3">
            <span class="bg-thread-red size-2.5 rounded-full"></span>
            <span class="bg-thread-gold size-2.5 rounded-full"></span>
            <span class="bg-thread-green size-2.5 rounded-full"></span>
            <span class="text-muted ml-3 font-mono text-xs">developer.ts</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[0.8125rem] leading-7 whitespace-pre-wrap"><code>{lines.map((line, n) => (<span class="type-line block" style={`--line: ${n}`}>{line.map(({ t, c }) => <span class={c}>{t}</span>)}</span>))}<span class="caret text-accent" /></code></pre>
        </div>
      </div>
    </div>
  </Container>

  <div class="mt-14 opacity-70">
    <Weave draw="load" height={48} />
  </div>
</section>
