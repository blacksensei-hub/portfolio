---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import Container from '../ui/Container.astro';
import MaskText from '../ui/MaskText.astro';
import StatusPill from '../ui/StatusPill.astro';
import Weave from '../ui/Weave.astro';

type Availability = NonNullable<CollectionEntry<'profile'>['data']['availability']>;

interface Props {
  name: string;
  role: string;
  tagline: string;
  email: string;
  availability?: Availability | undefined;
}

// The top of the page and its only <h1>, so it is not a Section (which owns an <h2>).
const { name, role, tagline, email, availability } = Astro.props;
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden pt-8 pb-24 md:pt-(--spacing-header)"
>
  {/* Pointer spotlight across the whole hero (interactions.ts); decorative. */}
  <div
    aria-hidden="true"
    data-spotlight
    class="spotlight pointer-events-none absolute inset-0 -z-10"
  ></div>

  {/*
    The woven band runs along the bottom edge, clear of the name: the site's
    signature, and the seam between the hero and the page.
  */}
  <div class="pointer-events-none absolute inset-x-0 bottom-6 -z-10 opacity-70 md:bottom-10">
    <Weave draw="load" height={64} />
  </div>

  <Container>
    {availability && (
      <div class="animate-rise mb-8 md:mb-10">
        <StatusPill status={availability.status} />
      </div>
    )}
    <h1 id="hero-heading" class="text-hero max-w-[11ch] font-bold tracking-tighter">
      <MaskText text={name} mode="load" delay={150} />
    </h1>
    <div class="animate-rise mt-8 grid gap-6 [animation-delay:550ms] md:mt-12 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="font-display text-h3 text-accent font-semibold">{role}</p>
        <p class="text-muted text-lede mt-3 max-w-[34ch]">{tagline}</p>
      </div>
      <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
        <ButtonLink href={`mailto:${email}`}>Email me</ButtonLink>
        <ButtonLink href="#projects" variant="secondary">
          See my work
        </ButtonLink>
      </div>
    </div>
  </Container>

  {/* Scroll cue: decorative, the content below is reachable by any means. */}
  <div
    aria-hidden="true"
    class="text-muted font-mono text-label absolute bottom-24 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 uppercase md:flex"
  >
    Scroll
    <span class="bg-border relative block h-12 w-px overflow-hidden">
      <span class="bg-accent absolute inset-x-0 top-0 h-1/2 animate-scroll-cue"></span>
    </span>
  </div>
</section>
