---
import Container from '../ui/Container.astro';

/*
 * "How a scan is checked" (spec 0022): AttendX's anti-proxy rules as one scan,
 * scrolled through. A pinned stage shows an illustration (not a real screen:
 * a projector, a phone, and the live register) while the step text beside it
 * changes; scan-story.ts maps scroll position to the step. Without that
 * script, or under reduced motion, the steps are a plain list beside the
 * finished state.
 */

// Decorative QR codes: a deterministic 21 by 21 grid with the three finder
// squares, not a real code.
function qrPath(seed: number): string {
  let s = seed;
  const rand = () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
  const finders = [
    [0, 0],
    [14, 0],
    [0, 14],
  ] as const;
  let d = '';
  for (let y = 0; y < 21; y++) {
    for (let x = 0; x < 21; x++) {
      let on: boolean | undefined;
      for (const [fx, fy] of finders) {
        if (x >= fx && x < fx + 7 && y >= fy && y < fy + 7) {
          on = Math.max(Math.abs(x - fx - 3), Math.abs(y - fy - 3)) !== 2;
        } else if (x >= fx - 1 && x < fx + 8 && y >= fy - 1 && y < fy + 8) {
          on = false;
        }
      }
      if (on ?? rand() < 0.48) d += `M${x} ${y}h1v1h-1z`;
    }
  }
  return d;
}
const codes = [qrPath(11), qrPath(23), qrPath(37)];

const steps = [
  {
    title: 'The code goes up',
    body: 'The lecturer opens the session and a QR code goes up on the projector. It changes every five seconds, so a photo of it is out of date almost at once.',
  },
  {
    title: 'A phone scans it',
    body: 'From their seat, a student scans with the app or any phone browser. The scan carries the code, where the phone is, and which phone it is.',
  },
  {
    title: 'Four checks',
    body: 'The code must still be fresh, the phone within the classroom zone, and the phone the one this student registered. The server also watches for one phone marking several students, and tells the lecturer at once.',
  },
  {
    title: 'On the register',
    body: 'The name lands on the lecturer’s live register straight away, over WebSockets. Nobody refreshes anything.',
  },
  {
    title: 'Or it’s refused',
    body: 'If a check fails, the scan is refused, and the attempt is kept. Patterns across refused scans, like repeated scans from outside the room, raise a flag for an admin to review.',
  },
];
const checks = [
  'Code is fresh',
  'Phone is in the room',
  'Registered phone',
  'One phone, one person',
];
const arrivals = ['Ekow Nkrumah', 'Naa Addo', 'Fiifi Mensah'];
---

<section aria-labelledby="scan-story-heading" class="scan-story pb-section" data-scan-story>
  <Container>
    <h2 id="scan-story-heading" class="text-h2 font-semibold">
      How a scan is checked
    </h2>
    <p class="text-muted mt-2 max-w-[56ch]">
      One scan, from the projector to the register. Scroll to step through it.
    </p>
  </Container>
  <div class="track" data-scan-track>
    <div class="stage" data-scan-stage>
      <Container>
        <div class="layout">
          <ol role="list" class="steps">
            {steps.map((step, n) => (
              <li data-scan-step={n} class="step">
                <p class="step-count text-accent font-mono text-label uppercase">
                  {String(n + 1).padStart(2, '0')} / {String(steps.length).padStart(2, '0')}
                </p>
                <h3 class="text-h3 mt-2 font-semibold">{step.title}</h3>
                <p class="text-muted mt-2">{step.body}</p>
              </li>
            ))}
          </ol>

          <figure class="visual-wrap">
            <div class="visual" aria-hidden="true">
              <div class="panel projector">
                <div class="bar">
                  <span>CSC 301 · Week 13</span>
                  <span class="live">● Live</span>
                </div>
                <div class="qr">
                  {codes.map((d, n) => (
                    <svg data-code={n} viewBox="-1 -1 23 23" shape-rendering="crispEdges">
                      <path d={d} />
                    </svg>
                  ))}
                </div>
                <p class="countdown">New code in 5s</p>
              </div>

              <div class="panel register">
                <div class="bar">
                  <span>Arrivals</span>
                  <span class="count">
                    <span class="before">33</span>
                    <span class="after">34</span> / 44
                  </span>
                </div>
                <ul>
                  <li class="arrival new">
                    <span>Akua Appiah</span>
                    <span class="badge">Present</span>
                  </li>
                  {arrivals.map((name) => (
                    <li class="arrival">
                      <span>{name}</span>
                      <span class="badge">Present</span>
                    </li>
                  ))}
                </ul>
                <p class="flag">⚑ Flag for review: repeated out-of-area scans</p>
              </div>

              <div class="phone">
                <div class="screen">
                  <div class="scr camera">
                    <span class="bracket tl"></span>
                    <span class="bracket tr"></span>
                    <span class="bracket bl"></span>
                    <span class="bracket br"></span>
                    <span class="beam"></span>
                    <p>Point at the code</p>
                  </div>
                  <div class="scr checking">
                    <p class="title">Checking</p>
                    <ul>
                      {checks.map((check, n) => (
                        <li data-check={n}>
                          <span class="tick"></span>
                          {check}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="scr done">
                    <span class="mark ok">✓</span>
                    <p>You’re marked present</p>
                    <small>CSC 301 · Week 13</small>
                  </div>
                  <div class="scr refused">
                    <span class="mark no">✕</span>
                    <p>Scan refused</p>
                    <small>Too far from Lecture Hall B</small>
                  </div>
                </div>
              </div>
            </div>
            <figcaption class="text-muted mt-3 text-center text-xs">
              An illustration of one scan, not a screenshot.
            </figcaption>
          </figure>
        </div>
      </Container>
    </div>
  </div>
</section>

<style>
  /* The phone sets off from beside the window; never let it widen the page. */
  .track {
    overflow-x: clip;
  }

  /* ── Static (no script, or reduced motion): steps as a list, the finished state beside it ── */
  .layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: 3rem;
    }
  }
  .steps {
    display: grid;
    gap: 1.5rem;
  }
  .visual-wrap {
    margin: 0;
  }
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 62svh;
    margin-inline: auto;
    width: 100%;
  }

  .panel {
    position: absolute;
    inset: 0 22% 8% 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-raised);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.45);
    overflow: hidden;
    transition:
      opacity 450ms var(--ease-out-soft),
      translate 600ms var(--ease-out-soft),
      scale 600ms var(--ease-out-soft);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  /* Mixed toward the text colour so the small label keeps 4.5:1 in both themes. */
  .live {
    color: color-mix(in oklch, var(--color-status-open) 70%, var(--color-on-surface));
  }

  /* The projector: a QR on white, as it would be on a screen. */
  .qr {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .qr svg {
    position: absolute;
    inset: 0;
    margin: auto;
    height: 86%;
    max-width: 86%;
    aspect-ratio: 1;
    padding: 3%;
    border-radius: 0.75rem;
    background: #fff;
    fill: #0b1020;
    opacity: 0;
    transition: opacity 180ms;
  }
  .qr svg[data-code='0'] {
    opacity: 1;
  }
  .countdown {
    padding: 0 0.9rem 0.8rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  /* The register. */
  .register ul {
    display: grid;
    gap: 0.4rem;
    padding: 0.75rem;
  }
  .arrival {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--color-surface);
    font-size: 0.8rem;
    transition:
      opacity 400ms var(--ease-out-soft),
      translate 500ms var(--ease-out-soft),
      background-color 400ms;
  }
  .arrival.new {
    border-color: color-mix(in oklch, var(--color-status-open) 55%, var(--color-border));
    background: color-mix(in oklch, var(--color-status-open) 10%, var(--color-surface));
  }
  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--color-status-open) 18%, transparent);
    color: color-mix(in oklch, var(--color-status-open) 70%, var(--color-on-surface));
    font-size: 0.68rem;
  }
  /* Small screens keep two earlier arrivals, so the review flag has room. */
  @media (max-width: 639px) {
    .register .arrival:nth-child(n + 4) {
      display: none;
    }
  }
  .count .before {
    display: none;
  }
  .flag {
    margin: auto 0.75rem 0.75rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.6rem;
    background: color-mix(in oklch, var(--color-status-limited) 16%, var(--color-surface));
    color: var(--color-on-surface);
    font-size: 0.75rem;
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 400ms var(--ease-out-soft),
      translate 500ms var(--ease-out-soft);
  }

  /* The phone: dark AttendX-style screens, one at a time. */
  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    aspect-ratio: 9 / 19;
    padding: 2.5%;
    border-radius: 1.6rem;
    background: #0b0b0f;
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.55);
    transition:
      translate 650ms var(--ease-out-soft),
      rotate 650ms var(--ease-out-soft),
      scale 650ms var(--ease-out-soft);
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #0f1630;
    color: #e8ecff;
  }
  .scr {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 12% 10%;
    text-align: center;
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 300ms;
  }
  .scr small {
    color: #a7b0d8;
    font-size: 0.62rem;
  }
  .scr.done {
    opacity: 1;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .mark.ok {
    background: #1f9d63;
  }
  .mark.no {
    background: #d14343;
  }

  .camera {
    background: radial-gradient(circle at 50% 45%, #1c2547, #0b1020 70%);
  }
  .camera p {
    position: absolute;
    bottom: 10%;
    color: #a7b0d8;
  }
  .bracket {
    position: absolute;
    width: 22%;
    aspect-ratio: 1;
    border: 2px solid #6d8cff;
  }
  .bracket.tl {
    top: 28%;
    left: 18%;
    border-right: 0;
    border-bottom: 0;
  }
  .bracket.tr {
    top: 28%;
    right: 18%;
    border-left: 0;
    border-bottom: 0;
  }
  .bracket.bl {
    bottom: 34%;
    left: 18%;
    border-right: 0;
    border-top: 0;
  }
  .bracket.br {
    bottom: 34%;
    right: 18%;
    border-left: 0;
    border-top: 0;
  }
  .beam {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 30%;
    height: 2px;
    background: #6d8cff;
    box-shadow: 0 0 12px #6d8cff;
    opacity: 0;
  }

  .checking {
    align-items: stretch;
    justify-content: flex-start;
    text-align: left;
  }
  .checking .title {
    margin-bottom: 0.4rem;
    color: #a7b0d8;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .checking ul {
    display: grid;
    gap: 0.5rem;
  }
  .checking li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    line-height: 1.2;
    opacity: 0.45;
    transition: opacity 250ms;
  }
  .tick {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    border: 1.5px solid #6d8cff;
    border-radius: 50%;
    transition:
      background-color 250ms,
      border-color 250ms;
  }

  /* Pinning lands at once, with no fade from the list (spec 0024). */
  [data-instant] :global(*) {
    transition: none !important;
  }

  /*
   * ── Enhanced: a pinned stage, one step at a time, driven by scroll ────────
   * Only where the stage fits: a phone on its side keeps the list (spec 0024).
   * Same query as PINNED in scan-story.ts.
   */
  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) {
    [data-enhanced] .track {
      height: calc(100svh + 5 * 70svh);
    }
    [data-enhanced] .stage {
      position: sticky;
      top: 0;
      display: grid;
      align-content: center;
      min-height: 100svh;
      padding-top: var(--spacing-header);
      padding-bottom: 1.5rem;
    }
    [data-enhanced] .steps {
      display: grid;
    }
    [data-enhanced] .step {
      grid-area: 1 / 1;
      opacity: 0;
      translate: 0 0.75rem;
      transition:
        opacity 350ms var(--ease-out-soft),
        translate 450ms var(--ease-out-soft);
    }
    [data-enhanced] .step[aria-current='step'] {
      opacity: 1;
      translate: 0 0;
    }
    @media (max-width: 1023px) {
      [data-enhanced] .layout {
        grid-template-rows: auto 1fr;
        margin-top: 0;
        gap: 1rem;
      }
      [data-enhanced] .visual-wrap {
        order: -1;
      }
      [data-enhanced] .visual {
        max-height: 46svh;
      }
      [data-enhanced] figcaption {
        display: none;
      }
    }

    /* Projector or register. */
    [data-step='0'] .register,
    [data-step='1'] .register,
    [data-step='2'] .register {
      opacity: 0;
      translate: 0 1rem;
      scale: 0.97;
    }
    [data-step='3'] .projector,
    [data-step='4'] .projector {
      opacity: 0;
      translate: 0 -1rem;
      scale: 0.97;
    }
    [data-step='0'] .projector,
    [data-step='1'] .projector,
    [data-step='2'] .projector,
    [data-step='3'] .register,
    [data-step='4'] .register {
      opacity: 1;
    }

    /* The code on the projector. */
    [data-code] .qr svg[data-code='0'] {
      opacity: 0;
    }
    [data-code='0'] .qr svg[data-code='0'],
    [data-code='1'] .qr svg[data-code='1'],
    [data-code='2'] .qr svg[data-code='2'] {
      opacity: 1;
    }

    /* The phone: aside, then over the code, then back with the result. */
    [data-step='0'] .phone {
      translate: 12% 14%;
      rotate: 8deg;
      scale: 0.92;
    }
    [data-step='1'] .phone {
      translate: -118% -12%;
      rotate: -4deg;
    }

    /* One screen at a time. */
    [data-step] .scr.done {
      opacity: 0;
    }
    [data-step='0'] .scr.camera,
    [data-step='1'] .scr.camera,
    [data-step='2'] .scr.checking,
    [data-step='3'] .scr.done,
    [data-step='4'] .scr.refused {
      opacity: 1;
    }
    [data-step='1'] .beam {
      opacity: 1;
      animation: scan-beam 1.4s ease-in-out infinite alternate;
    }
    /* Paused from the header (spec 0024). */
    :global(:root[data-motion='paused']) [data-step='1'] .beam {
      animation-play-state: paused;
    }

    /* The checks tick off in order. */
    [data-checks='1'] [data-check='0'],
    [data-checks='2'] :is([data-check='0'], [data-check='1']),
    [data-checks='3'] :is([data-check='0'], [data-check='1'], [data-check='2']),
    [data-checks='4'] [data-check] {
      opacity: 1;
    }
    [data-checks='1'] [data-check='0'] .tick,
    [data-checks='2'] :is([data-check='0'], [data-check='1']) .tick,
    [data-checks='3'] :is([data-check='0'], [data-check='1'], [data-check='2']) .tick,
    [data-checks='4'] [data-check] .tick {
      background: #1f9d63;
      border-color: #1f9d63;
    }

    /* The register: the new arrival and the count change only once the scan passes. */
    [data-step='0'] .arrival.new,
    [data-step='1'] .arrival.new,
    [data-step='2'] .arrival.new {
      opacity: 0;
      translate: 0 -0.75rem;
    }
    [data-step='0'] .count .before,
    [data-step='1'] .count .before,
    [data-step='2'] .count .before {
      display: inline;
    }
    [data-step='0'] .count .after,
    [data-step='1'] .count .after,
    [data-step='2'] .count .after {
      display: none;
    }
    [data-step='4'] .flag {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes scan-beam {
    to {
      top: 64%;
    }
  }
</style>

<script>
  import { initScanStory } from '../../lib/scan-story';

  initScanStory();
</script>
