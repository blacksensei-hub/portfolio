---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import Card from '../ui/Card.astro';
import DevicePreview from '../ui/DevicePreview.astro';
import Link from '../ui/Link.astro';
import Tag from '../ui/Tag.astro';
import Weave from '../ui/Weave.astro';

/** A case study screenshot: the gallery's image and alt text. */
type Shot = { image: ImageMetadata; alt: string };

interface Props {
  project: CollectionEntry<'projects'>['data'];
  /** 1 based position, shown as the mono "01". */
  number?: number;
  /** Puts the image on the right from lg up, so rows alternate. */
  flip?: boolean;
  /** The project's case study page, when it has one (spec 0016). */
  caseStudyHref?: string | undefined;
  /**
   * Real screens from the case study (spec 0020): a desktop shot in a browser
   * window, with a phone shot resting on its corner. Replaces the project image.
   */
  preview?: { desktop: Shot; phone?: Shot | undefined } | undefined;
}

const { project, number = 1, flip = false, caseStudyHref, preview } = Astro.props;
const { title, summary, tech, demoUrl, repoUrl, image } = project;
---

<Card>
  {/* Card takes no class, so the row layout lives inside it. */}
  <div class="grid h-full gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
    {preview ? (
      <div class:list={['lg:col-span-7', flip && 'lg:order-last']}>
        <DevicePreview
          desktop={preview.desktop}
          phone={preview.phone}
          slug={project.slug}
          liveHref={demoUrl}
        />
      </div>
    ) : (
      <div
        class:list={[
          'rounded-card border-border bg-surface relative aspect-video overflow-hidden border lg:col-span-7',
          flip && 'lg:order-last',
        ]}
      >
        {image ? (
          // Oversized and drifting with scroll (parallax), so the frame never shows an edge.
          <div class="parallax absolute inset-x-0 -inset-y-[8%]">
            <Image
              src={image}
              alt={title}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 44rem, 100vw"
              class="size-full object-cover object-left transition-transform duration-(--duration-hover) ease-(--ease-out-soft) group-hover/card:scale-[1.04]"
            />
            {demoUrl && (
              // A hover shortcut to the live site. The labelled "Live demo" link below is the
              // accessible one, so this stays out of the tab order and the tree.
              <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class="bg-surface/60 absolute inset-0 grid place-items-center opacity-0 backdrop-blur-sm transition-opacity duration-(--duration-hover) group-hover/card:opacity-100"
              >
                <span class="rounded-tag border-border bg-surface text-on-surface border px-4 py-2 font-mono text-xs uppercase shadow-lg">
                  Visit live site ↗
                </span>
              </a>
            )}
          </div>
        ) : (
          <div class="flex size-full items-center" aria-hidden="true">
            <Weave height={120} />
          </div>
        )}
      </div>
    )}
    <div class="flex h-full flex-col gap-4 lg:col-span-5">
      <p class="flex items-center gap-3 font-mono text-label uppercase" aria-hidden="true">
        <span class="text-accent">{String(number).padStart(2, '0')}</span>
        {number === 1 && (
          <span class="rounded-tag border-accent/40 bg-accent/10 text-accent border px-2.5 py-0.5">
            ★ Featured
          </span>
        )}
      </p>
      <h3 class="text-display font-bold">{title}</h3>
      <p class="text-muted">{summary}</p>
      <ul class="flex flex-wrap gap-2" aria-label="Tech used">
        {tech.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
      {caseStudyHref && (
        <a
          href={caseStudyHref}
          class="group/cs border-accent/40 hover:border-accent hover:bg-accent hover:text-on-accent text-accent rounded-tag mt-auto inline-flex min-h-11 items-center gap-2 self-start border px-4 font-mono text-xs font-medium uppercase transition-colors"
        >
          Read case study<span class="sr-only">, {title}</span>
          <span aria-hidden="true" class="transition-transform group-hover/cs:translate-x-1">
            →
          </span>
        </a>
      )}
      <p class:list={['flex flex-wrap gap-6 pt-2 font-medium', !caseStudyHref && 'mt-auto']}>
        {demoUrl && (
          <Link href={demoUrl}>
            Live demo<span class="sr-only">, {title}</span>
          </Link>
        )}
        {repoUrl && (
          <Link href={repoUrl}>
            Source code<span class="sr-only">, {title}</span>
          </Link>
        )}
      </p>
    </div>
  </div>
</Card>
