---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import Section from '../ui/Section.astro';
import StatusPill from '../ui/StatusPill.astro';

type Availability = NonNullable<CollectionEntry<'profile'>['data']['availability']>;

interface Props {
  services: CollectionEntry<'services'>[];
  availability?: Availability | undefined;
}

const { availability } = Astro.props;
const sorted = [...Astro.props.services].sort((a, b) => a.data.order - b.data.order);
---

{/* An empty services.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="work-with-me" title="Work with me" index="04">
    {availability && (
      <div class="reveal mb-12">
        <StatusPill status={availability.status} note={availability.note} />
      </div>
    )}
    {/* Numbered, open columns under a gold rule: two by two, so four services never leave a hole. */}
    <ol role="list" class="grid gap-x-12 gap-y-12 md:grid-cols-2">
      {sorted.map((entry, n) => (
        <li class="reveal grid">
          <article class="group/svc border-border relative border-t pt-6">
            <span
              aria-hidden="true"
              class="bg-accent absolute -top-px left-0 h-0.5 w-12 transition-[width] duration-(--duration-hover) ease-(--ease-out-soft) group-hover/svc:w-full"
            />
            <p class="font-mono text-label text-accent mb-3 uppercase" aria-hidden="true">
              {String(n + 1).padStart(2, '0')}
            </p>
            <h3 class="text-h3 font-semibold tracking-tight">{entry.data.title}</h3>
            <p class="text-muted mt-3 max-w-[48ch]">{entry.data.blurb}</p>
          </article>
        </li>
      ))}
    </ol>
    <div class="reveal mt-14">
      <ButtonLink href="#contact">Get in touch</ButtonLink>
    </div>
  </Section>
)}
