---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';

type Availability = NonNullable<CollectionEntry<'profile'>['data']['availability']>;
type Status = Availability['status'];

interface Props {
  services: CollectionEntry<'services'>[];
  availability?: Availability | undefined;
}

// Keyed on the schema enum, so a new status fails type checking until it has a label.
const labels: Record<Status, string> = {
  open: 'Available',
  limited: 'Limited availability',
  closed: 'Booked',
};

// Full literal class names: Tailwind 4 only generates classes written out in source.
const dots: Record<Status, string> = {
  open: 'bg-status-open',
  limited: 'bg-status-limited',
  closed: 'bg-status-closed',
};

const { availability } = Astro.props;
const sorted = [...Astro.props.services].sort((a, b) => a.data.order - b.data.order);
---

{/* An empty services.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="work-with-me" title="Work with me">
    {availability && (
      <p class="mb-6 inline-flex items-center gap-2 text-on-surface">
        <span
          aria-hidden="true"
          class:list={['size-2.5 shrink-0 rounded-full', dots[availability.status]]}
        />
        <span>
          <strong>{labels[availability.status]}</strong>. {availability.note}
        </span>
      </p>
    )}
    <ul role="list" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sorted.map((entry) => (
        <li class="grid">
          <Card>
            <h3 class="text-h3 font-semibold tracking-tight">{entry.data.title}</h3>
            <p class="mt-2 text-muted">{entry.data.blurb}</p>
          </Card>
        </li>
      ))}
    </ul>
    <div class="mt-8">
      <ButtonLink href="#contact">Get in touch</ButtonLink>
    </div>
  </Section>
)}
