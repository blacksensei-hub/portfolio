---
import type { CollectionEntry } from 'astro:content';

import Section from '../ui/Section.astro';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const sorted = [...Astro.props.skills].sort((a, b) => a.data.order - b.data.order);
---

{/* An empty skills.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="skills" title="Skills" index="03" hint="Tools I use">
    {/* A ruled list, not a grid of cards: one row per group, so there is never a hole. */}
    <ul role="list" class="border-border border-t">
      {sorted.map((entry, n) => {
        // Position based, so the id is always unique and valid whatever the group name holds.
        const headingId = `skill-group-${n}`;
        return (
          <li class="reveal border-border group/row grid gap-3 border-b py-4 md:grid-cols-12 md:items-center md:gap-8">
            <h3
              id={headingId}
              class="group-hover/row:text-accent text-base font-semibold tracking-tight transition-colors md:col-span-3"
            >
              {entry.data.group}
            </h3>
            <ul role="list" aria-labelledby={headingId} class="flex flex-wrap gap-2 md:col-span-9">
              {entry.data.items.map((item) => (
                <li class="rounded-tag border-border bg-surface-raised text-muted hover:border-accent hover:text-on-surface border px-3 py-1 text-sm transition-[color,border-color,translate] duration-(--duration-hover) ease-(--ease-out-soft) hover:-translate-y-0.5">
                  {item}
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </Section>
)}
