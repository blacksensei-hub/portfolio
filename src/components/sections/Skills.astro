---
import type { CollectionEntry } from 'astro:content';

import Section from '../ui/Section.astro';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const sorted = [...Astro.props.skills].sort((a, b) => a.data.order - b.data.order);
---

{/* An empty skills.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="skills" title="Skills" index="03" layout="split">
    {/* A ruled list, not a grid of cards: one row per group, so there is never a hole. */}
    <ul role="list" class="border-border border-t">
      {sorted.map((entry, n) => {
        // Position based, so the id is always unique and valid whatever the group name holds.
        const headingId = `skill-group-${n}`;
        return (
          <li class="reveal border-border group/row grid gap-3 border-b py-6 md:grid-cols-12 md:items-baseline md:gap-8">
            <h3
              id={headingId}
              class="text-h3 group-hover/row:text-accent font-semibold tracking-tight transition-colors md:col-span-4"
            >
              {entry.data.group}
            </h3>
            <ul
              role="list"
              aria-labelledby={headingId}
              class="text-muted flex flex-wrap gap-x-4 gap-y-1 text-lg md:col-span-8"
            >
              {entry.data.items.map((item, i) => (
                <li class="inline-flex items-center gap-4">
                  {i > 0 && (
                    <span aria-hidden="true" class="bg-thread-gold size-1.5 rounded-full" />
                  )}
                  {item}
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </Section>
)}
