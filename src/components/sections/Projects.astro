---
import type { CollectionEntry } from 'astro:content';

import Section from '../ui/Section.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const sorted = [...Astro.props.projects].sort((a, b) => a.data.order - b.data.order);
---

{/* An empty projects.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="projects" title="Projects">
    <ul role="list" class="grid gap-6 md:grid-cols-2">
      {sorted.map((entry) => (
        <li class="grid">
          <ProjectCard project={entry.data} />
        </li>
      ))}
    </ul>
  </Section>
)}
