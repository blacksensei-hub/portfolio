---
import type { CollectionEntry } from 'astro:content';

import Section from '../ui/Section.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Case studies, matched to their project by the reference (spec 0016). */
  caseStudies?: CollectionEntry<'caseStudies'>[];
}

const sorted = [...Astro.props.projects].sort((a, b) => a.data.order - b.data.order);
const studyFor = new Map(
  (Astro.props.caseStudies ?? []).map((study) => [study.data.project.id, `/projects/${study.id}/`]),
);
// The card's preview (spec 0020): the case study's shots marked `card: true`,
// else its first desktop and first phone screen.
const previewFor = new Map(
  (Astro.props.caseStudies ?? []).flatMap((study) => {
    const pick = (device: 'desktop' | 'phone') => {
      const shots = study.data.gallery.filter((shot) => shot.device === device);
      return shots.find((shot) => shot.card) ?? shots[0];
    };
    const desktop = pick('desktop');
    const phone = pick('phone');
    return desktop ? [[study.data.project.id, { desktop, phone }] as const] : [];
  }),
);
---

{/* An empty projects.yaml is valid content, so the section simply disappears. */}
{sorted.length > 0 && (
  <Section id="projects" title="Projects" index="02" hint="Selected work">
    {/* One full width feature row per project; the image side alternates on desktop. */}
    <ul role="list" class="grid gap-8 md:gap-12">
      {sorted.map((entry, n) => (
        <li class="reveal grid">
          <ProjectCard
            project={entry.data}
            number={n + 1}
            flip={n % 2 === 1}
            caseStudyHref={studyFor.get(entry.id)}
            preview={previewFor.get(entry.id)}
          />
        </li>
      ))}
    </ul>
  </Section>
)}
