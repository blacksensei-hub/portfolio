---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import { glyphs } from '../ui/glyphs';
import Section from '../ui/Section.astro';
import { isExternal } from '../ui/isExternal';

interface Props {
  links: CollectionEntry<'links'>[];
  resume?: string | undefined;
}

const { resume } = Astro.props;
const sorted = [...Astro.props.links].sort((a, b) => a.data.order - b.data.order);

// The quiet second line under each label: the address itself, minus the scheme and query.
function detail(href: string): string {
  return href.replace(/^(https?:\/\/|mailto:|tel:)/, '').replace(/\?.*$/, '');
}
---

{/* No links and no resume is valid content, so the section simply disappears. */}
{(sorted.length > 0 || resume !== undefined) && (
  <Section id="contact" title="Contact" index="05" hint="Say hello">
    {/*
      The closing call to action: a glass card with a spinning glow ring and a
      typewriter that cycles through what we could build. Screen readers get
      one plain sentence; the moving words are aria-hidden.
    */}
    <div class="reveal glass glow-border glow-border-on rounded-card relative isolate overflow-hidden px-6 py-12 text-center md:px-12">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="animate-aurora aurora-blob text-thread-gold/20 absolute -top-1/2 left-1/4 size-[28rem] rounded-full"></div>
        <div class="animate-aurora aurora-blob text-thread-green/15 absolute -bottom-1/2 right-1/4 size-[24rem] rounded-full [animation-delay:-8s]"></div>
      </div>
      <p class="font-display text-display font-semibold tracking-tight">
        <span class="sr-only">Let's build your next idea.</span>
        <span aria-hidden="true">
          Let's build your{' '}
          <span
            class="text-accent caret"
            data-typewriter='["web app","mobile app","API","next idea"]'
          >
            next idea
          </span>
        </span>
      </p>
      <p class="text-muted mx-auto mt-3 max-w-[44ch]">
        Have a project or an opportunity in mind? Pick whichever way suits you and I'll get back to
        you.
      </p>
      {sorted.length > 0 && (
        <ul role="list" class="mx-auto mt-8 grid max-w-2xl gap-3 text-left sm:grid-cols-2">
          {sorted.map(({ data }) => {
            const external = isExternal(data.href);
            return (
              <li>
                <a
                  href={data.href}
                  class="group/link rounded-card border-border bg-surface/40 hover:border-accent flex min-h-11 items-center gap-4 border px-4 py-3 transition-[border-color,background-color,translate] duration-(--duration-hover) ease-(--ease-out-soft) hover:-translate-y-0.5"
                  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  <span
                    aria-hidden="true"
                    class="rounded-card bg-accent/10 text-accent group-hover/link:bg-accent group-hover/link:text-on-accent grid size-10 shrink-0 place-items-center transition-colors"
                  >
                    <svg focusable="false" viewBox="0 0 24 24" class="size-5 fill-current">
                      <path d={glyphs[data.icon]} />
                    </svg>
                  </span>
                  <span class="flex min-w-0 flex-col">
                    <span class="font-display font-semibold">{data.label}</span>
                    <span class="text-muted truncate font-mono text-xs">{detail(data.href)}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="text-accent ml-auto transition-transform duration-(--duration-hover) ease-(--ease-out-soft) group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                  >
                    ↗
                  </span>
                  {external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </li>
            );
          })}
        </ul>
      )}
      {resume !== undefined && (
        <div class="mt-8">
          <ButtonLink href={resume} download>
            Download resume (PDF)
          </ButtonLink>
        </div>
      )}
    </div>
  </Section>
)}
