---
import type { CollectionEntry } from 'astro:content';

import ButtonLink from '../ui/ButtonLink.astro';
import Section from '../ui/Section.astro';
import { isExternal } from '../ui/isExternal';

interface Props {
  links: CollectionEntry<'links'>[];
  resume?: string | undefined;
}

type IconKey = CollectionEntry<'links'>['data']['icon'];

// The glyph map lives here, not in the data (spec 0002): a glyph is presentation.
// Keyed on the schema enum, so a new icon key fails type checking until it has a glyph.
const glyphs: Record<IconKey, string> = {
  github:
    'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z',
  email:
    'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.6-8-5.6ZM5.2 7 12 11.8 18.8 7H5.2Z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z',
  whatsapp:
    'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.05 21.8h-.01a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88Zm8.41-18.3A11.81 11.81 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.9-11.9a11.82 11.82 0 0 0-3.49-8.4Z',
  phone:
    'M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z',
};

const { resume } = Astro.props;
const sorted = [...Astro.props.links].sort((a, b) => a.data.order - b.data.order);

// The quiet second line under each label: the address itself, minus the scheme and query.
function detail(href: string): string {
  return href.replace(/^(https?:\/\/|mailto:|tel:)/, '').replace(/\?.*$/, '');
}
---

{/* No links and no resume is valid content, so the section simply disappears. */}
{(sorted.length > 0 || resume !== undefined) && (
  <Section id="contact" title="Contact" index="05">
    <p class="reveal font-display text-display mb-14 max-w-[16ch] font-semibold tracking-tight">
      Have a project in mind? <span class="text-accent">Let's talk.</span>
    </p>
    {sorted.length > 0 && (
      <ul role="list" class="border-border grid border-t md:grid-cols-2 md:gap-x-12">
        {sorted.map(({ data }) => {
          const external = isExternal(data.href);
          return (
            <li class="reveal border-border border-b">
              <a
                href={data.href}
                class="group/link from-accent/10 flex min-h-11 items-center gap-5 bg-gradient-to-r to-transparent bg-[length:0%_100%] bg-no-repeat px-2 py-6 transition-[color,background-size] duration-(--duration-hover) ease-(--ease-out-soft) hover:bg-[length:100%_100%] hover:text-accent"
                {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
              >
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  class="text-accent size-6 shrink-0 fill-current"
                >
                  <path d={glyphs[data.icon]} />
                </svg>
                <span class="flex min-w-0 flex-col">
                  <span class="text-h3 font-display font-semibold tracking-tight">
                    {data.label}
                  </span>
                  <span class="text-muted truncate font-mono text-xs">{detail(data.href)}</span>
                </span>
                <span
                  aria-hidden="true"
                  class="text-accent ml-auto text-xl transition-transform duration-(--duration-hover) ease-(--ease-out-soft) group-hover/link:translate-x-1 group-hover/link:-translate-y-1"
                >
                  ↗
                </span>
                {external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          );
        })}
      </ul>
    )}
    {resume !== undefined && (
      <div class="mt-10">
        <ButtonLink href={resume} download>
          Download resume (PDF)
        </ButtonLink>
      </div>
    )}
  </Section>
)}
