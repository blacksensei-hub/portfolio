---
import { getCollection, getEntry } from 'astro:content';

import About from '../components/sections/About.astro';
import Hero from '../components/sections/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = (await getEntry('profile', 'profile'))?.data;

// Read so the projects collection resolves at build time (an unread collection
// never forces image resolution, so AC-8's missing file check would never fire).
// The projects section (feature 6) replaces this with the real read.
await getCollection('projects');
---

<BaseLayout
  title={profile ? `${profile.name} · ${profile.role}` : 'Portfolio'}
  description={profile?.tagline ?? 'A personal portfolio.'}
>
  {profile && (
    <>
      <Hero
        name={profile.name}
        role={profile.role}
        tagline={profile.tagline}
        email={profile.email}
      />
      <About bio={profile.bio} />
    </>
  )}
</BaseLayout>
