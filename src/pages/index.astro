---
import { getCollection, getEntry } from 'astro:content';

import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import WorkWithMe from '../components/sections/WorkWithMe.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import TechMarquee from '../components/ui/TechMarquee.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildJsonLd } from '../lib/seo';

const profile = (await getEntry('profile', 'profile'))?.data;
// No generic fallback: a preview that says "Portfolio" is worse than a failed build.
if (!profile) throw new Error('profile.yaml is missing');

// Also what makes image paths resolve at build time, so a missing project image
// fails the build (spec 0002, AC-8).
const projects = await getCollection('projects');
const skills = await getCollection('skills');
const links = await getCollection('links');
const services = await getCollection('services');
const caseStudies = await getCollection('caseStudies');

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const technologies = skills.toSorted(byOrder).flatMap((group) => group.data.items);
const socials = links.toSorted(byOrder).map((link) => link.data);
---

<BaseLayout
  title={`${profile.name} · ${profile.role}`}
  description={profile.tagline}
  social={{
    image: '/og.png',
    imageAlt: `${profile.name}, ${profile.role}`,
    siteName: profile.name,
    jsonLd: buildJsonLd(
      profile,
      links.map((link) => link.data),
      new URL('/', Astro.site),
    ),
  }}
>
  <SiteHeader
    slot="header"
    name={profile.name}
    links={socials}
    sections={[
      { id: 'about', label: 'About' },
      { id: 'projects', label: 'Projects' },
      { id: 'skills', label: 'Skills' },
      { id: 'work-with-me', label: 'Services' },
      { id: 'contact', label: 'Contact' },
    ]}
  />
  <Hero
    name={profile.name}
    role={profile.role}
    tagline={profile.tagline}
    email={profile.email}
    availability={profile.availability}
    stack={['React', 'React Native', 'Node.js', 'PostgreSQL']}
    stats={[
      { value: projects.length, label: 'Projects shipped' },
      { value: technologies.length, label: 'Technologies' },
      { value: services.length, label: 'Services' },
    ]}
  />
  <About bio={profile.bio} email={profile.email} availability={profile.availability} />
  <TechMarquee items={technologies} />
  <Projects projects={projects} caseStudies={caseStudies} />
  <Skills skills={skills} />
  <WorkWithMe services={services} availability={profile.availability} />
  <Contact links={links} resume={profile.resume} />
</BaseLayout>
