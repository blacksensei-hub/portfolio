---
import { getCollection, getEntry } from 'astro:content';

import About from '../components/sections/About.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = (await getEntry('profile', 'profile'))?.data;

// Also what makes image paths resolve at build time, so a missing project image
// fails the build (spec 0002, AC-8).
const projects = await getCollection('projects');
---

<BaseLayout
  title={profile ? `${profile.name} · ${profile.role}` : 'Portfolio'}
  description={profile?.tagline ?? 'A personal portfolio.'}
>
  {profile && (
    <>
      <Hero
        name={profile.name}
        role={profile.role}
        tagline={profile.tagline}
        email={profile.email}
      />
      <About bio={profile.bio} />
    </>
  )}
  <Projects projects={projects} />
</BaseLayout>
